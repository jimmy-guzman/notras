{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "prettier": {
      "disabled": true
    },
    "biome": {
      "command": ["pnpm", "exec", "ultracite", "fix", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".css",
        ".json",
        ".jsonc",
        ".html"
      ]
    }
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "knip": {
      "type": "local",
      "command": ["npx", "@knip/mcp@latest"],
      "enabled": true
    },
    "next.js": {
      "type": "local",
      "command": ["npx", "next-devtools-mcp@latest"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
